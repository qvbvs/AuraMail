{
  "name": "auramail",
  "version": "0.1.0",
  "description": "AuraMail — nowoczesny klient poczty (Electron)",
  "main": "./out/main/index.js",
  "author": {
    "name": "qvbvs",
    "email": "jakubwalecki25@gmail.com"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/qvbvs/auramail.git"
  },
  "scripts": {
    "setup": "node scripts/install-electron.mjs && node scripts/rebuild-native.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:all": "electron-vite build && electron-builder --win --linux",
    "release": "electron-vite build && electron-builder --win --publish always",
    "release:draft": "electron-vite build && electron-builder --win --publish always --config.publish.releaseType=draft",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "lint": "eslint . --ext .ts,.tsx"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "@fluentui/react-components": "^9.54.0",
    "@fluentui/react-icons": "^2.0.253",
    "@tiptap/extension-link": "^2.10.3",
    "@tiptap/extension-underline": "^2.10.3",
    "@tiptap/react": "^2.10.3",
    "@tiptap/starter-kit": "^2.10.3",
    "better-sqlite3-multiple-ciphers": "^11.5.0",
    "dompurify": "^3.2.1",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9",
    "imapflow": "^1.0.181",
    "keytar": "^7.9.0",
    "mailparser": "^3.7.2",
    "nodemailer": "^6.9.16",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/mailparser": "^3.4.5",
    "@types/nodemailer": "^6.4.16",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "adm-zip": "^0.5.16",
    "autoprefixer": "^10.6.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
